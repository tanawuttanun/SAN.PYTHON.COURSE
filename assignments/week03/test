def check_age_group(age):
    if age <= 12:
        return "Child"
    elif 13 <= age <= 19:
        return "Teenager"
    elif 20 <= age <= 59:
        return "Adult"
    elif age >= 60:
        return "Senior"
    else:
        return "Invalid"

age = int(input("Enter how old are you ? :"))
print("You are:", check_age_group(age))

